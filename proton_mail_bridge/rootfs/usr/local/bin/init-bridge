#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: Proton Mail Bridge
# Initialization script
# ==============================================================================

bashio::log.info "Initializing Proton Mail Bridge environment..."

# Persistent storage directories under /data
mkdir -p /data/protonmail/config \
         /data/protonmail/data \
         /data/protonmail/cache \
         /data/pass \
         /data/gnupg

chmod 700 /data/gnupg /data/pass

# Ensure home and standard user directories
mkdir -p /root/.config /root/.local/share /root/.cache

# Symlink persistent paths
ln -sfn /data/protonmail/config /root/.config/protonmail
ln -sfn /data/protonmail/data /root/.local/share/protonmail
ln -sfn /data/protonmail/cache /root/.cache/protonmail
ln -sfn /data/pass /root/.password-store
ln -sfn /data/gnupg /root/.gnupg

# Initialize GPG key if not already present
if ! gpg --list-secret-keys "Proton Mail Bridge" >/dev/null 2>&1; then
    bashio::log.info "Generating GPG key for Proton Mail Bridge pass store..."
    gpg --batch --passphrase '' --quick-gen-key "Proton Mail Bridge" default default never
fi

# Initialize pass store if not initialized
if [ ! -f /data/pass/.gpg-id ]; then
    bashio::log.info "Initializing pass password store..."
    pass init "Proton Mail Bridge"
fi

# Ensure bridge-v3 config exists and prefers pass
mkdir -p /data/protonmail/config/bridge-v3
if [ ! -f /data/protonmail/config/bridge-v3/prefs.json ]; then
    echo '{"preferred_keychain":"pass"}' > /data/protonmail/config/bridge-v3/prefs.json
else
    TMP_PREFS=$(jq '.preferred_keychain = "pass"' /data/protonmail/config/bridge-v3/prefs.json 2>/dev/null)
    if [ -n "$TMP_PREFS" ]; then
        echo "$TMP_PREFS" > /data/protonmail/config/bridge-v3/prefs.json
    fi
fi

# Export certificate to /ssl if requested and present
if bashio::config.true 'copy_cert_to_ssl'; then
    CERT_FILE="/data/protonmail/data/bridge-v3/cert.pem"
    if [ -f "$CERT_FILE" ]; then
        mkdir -p /ssl
        cp "$CERT_FILE" /ssl/proton-bridge-cert.pem
        bashio::log.info "Exported TLS certificate to /ssl/proton-bridge-cert.pem"
    fi
fi

bashio::log.info "Proton Mail Bridge initialization finished."
